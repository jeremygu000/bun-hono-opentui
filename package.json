{
  "name": "bun-hono-opentui",
  "private": true,
  "workspaces": ["server", "cli"],
  "scripts": {
    "dev:server": "bun run --cwd server dev",
    "dev:cli": "bun run --cwd cli dev",
    "start:server": "bun run --cwd server start",
    "start:cli": "bun run --cwd cli start",
    "typecheck": "bun run --cwd server typecheck && bun run --cwd cli typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
